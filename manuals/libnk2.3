.Dd June 13, 2026
.Dt LIBNK2 3
.Os
.Sh NAME
.Nm libnk2.h
.Nd Library to access the Nickfile (NK2) format
.Sh SYNOPSIS
.In libnk2.h
.Pp
Support functions
.nf
.Ft const char *
.Fo libnk2_get_version
.Fa "void"
.Fc
.fi
.nf
.Ft int
.Fo libnk2_get_access_flags_read
.Fa "void"
.Fc
.fi
.nf
.Ft int
